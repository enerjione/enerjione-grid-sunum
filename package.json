{
  "name": "enerjione-grid-sunum",
  "version": "1.0.0",
  "private": true,
  "description": "EnerjiOne Grid - Scroll tabanli tanitim sunumu",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "build:offline": "vite build --config vite.config.offline.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.enerjione.grid.sunum",
    "productName": "EnerjiOne Grid Sunum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "EnerjiOne-Grid-Sunum.exe",
      "unicode": true
    },
    "compression": "maximum"
  }
}
